{
  "name": "frame-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark": "bun run web/dev-server.ts --benchmark",
    "record:demo": "bun run scripts/record-demo.ts",
    "dev": "bun run web/dev-server.ts",
    "build:wasm": "bun run scripts/build-wasm.mjs",
    "fixtures:generate": "bun run core/fixtures/generate-timesampler-fixtures.mjs",
    "prep:analyze": "bun run prep/scripts/analyze-track.mjs",
    "prep:verify": "bun run scripts/verify-track-beats.mjs",
    "test:rust-spike": "cargo test --manifest-path core/archive/rust-spike/Cargo.toml",
    "test:zig": "bun run scripts/test-zig.mjs",
    "test:wasm-remap": "bun run scripts/test-wasm-remap.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.72",
    "midi-file": "1.2.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@libmedia/avplayer": "1.3.1",
    "mediabunny": "^1.56.1"
  }
}
